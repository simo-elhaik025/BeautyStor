# Example env for docker-compose (DO NOT COMMIT SECRETS)
# Copy to .env and customize for local development

# MySQL
MYSQL_DATABASE=beautystor_db
MYSQL_USER=beauty_user
MYSQL_PASSWORD=change_me_password
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_PORT=3306

# Backend
SERVER_PORT=8080
# Use a strong random base64 secret in production. Example length >= 32 bytes base64
JWT_SECRET=Zm9vYmFyZm9vYmFyZm9vYmFyZm9vYmFyZm9vYmFy
# Durations: PT15M = 15 minutes, P7D = 7 days
JWT_ACCESS_TOKEN_EXPIRATION=PT15M
JWT_REFRESH_TOKEN_EXPIRATION=P7D
